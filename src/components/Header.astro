---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: '首页',   href: base },
  { label: '文档',   href: `${base}docs/` },
  { label: '论文',   href: `${base}papers/` },
  { label: '项目',   href: `${base}projects/` },
  { label: '实验', href: `${base}lab/` },
  { label: '博客',   href: `${base}blog/` },
  { label: '关于',   href: `${base}about/` },
];

const isActive = (href: string) => {
  if (href === base) return currentPath === base || currentPath === base.slice(0, -1);
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/90 backdrop-blur-sm">
  <div class="container-wiki h-14 flex items-center gap-6">

    <!-- Logo -->
    <a href={base} class="font-semibold text-[var(--color-text)] shrink-0 hover:text-accent transition-colors">
      个人知识库
    </a>

    <!-- Nav (desktop) -->
    <nav class="hidden md:flex items-center gap-1 flex-1">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={[
            'px-3 py-1.5 rounded-md text-sm transition-colors',
            isActive(item.href)
              ? 'text-[var(--color-text)] font-medium bg-[var(--color-surface)]'
              : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface)]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <!-- GitHub -->
      <a
        href="https://github.com/Sakura-beautiful"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm
               text-[var(--color-text-muted)] hover:text-[var(--color-text)]
               hover:bg-[var(--color-surface)] transition-colors"
        aria-label="GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span class="hidden lg:inline">GitHub</span>
      </a>

      <!-- Dark mode toggle -->
      <button
        id="theme-toggle"
        class="flex items-center justify-center w-8 h-8 rounded-md
               text-[var(--color-text-muted)] hover:text-[var(--color-text)]
               hover:bg-[var(--color-surface)] transition-colors"
        aria-label="Toggle dark mode"
      >
        <svg id="icon-sun" class="hidden dark:block w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg id="icon-moon" class="block dark:hidden w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
        </svg>
      </button>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-8 h-8 rounded-md
               text-[var(--color-text-muted)] hover:text-[var(--color-text)]
               hover:bg-[var(--color-surface)] transition-colors"
        aria-label="Toggle menu"
      >
        <svg id="icon-menu" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="hidden w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]">
    <nav class="container-wiki py-3 flex flex-col gap-1">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={[
            'px-3 py-2 rounded-md text-sm transition-colors',
            isActive(item.href)
              ? 'text-[var(--color-text)] font-medium bg-[var(--color-surface)]'
              : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface)]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('starlight-theme', isDark ? 'dark' : 'light');
  });

  mobileBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    iconMenu?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
