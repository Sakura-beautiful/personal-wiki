---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-[var(--color-border)] mt-24">
  <div class="container-wiki py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-[var(--color-text-muted)]">
      © {currentYear} Personal Wiki · Built with
      <a href="https://astro.build" target="_blank" rel="noopener" class="hover:text-[var(--color-text)] transition-colors">Astro</a>
      &
      <a href="https://starlight.astro.build" target="_blank" rel="noopener" class="hover:text-[var(--color-text)] transition-colors">Starlight</a>
    </p>
    <div class="flex items-center gap-4 text-sm text-[var(--color-text-muted)]">
      <a href={`${base}about/`} class="hover:text-[var(--color-text)] transition-colors">About</a>
      <a href="https://github.com/Sakura-beautiful" target="_blank" rel="noopener" class="hover:text-[var(--color-text)] transition-colors">GitHub</a>
    </div>
  </div>
</footer>
