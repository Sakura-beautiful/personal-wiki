---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="A brief introduction.">
  <div class="container-wiki py-16 max-w-2xl">
    <h1 class="text-2xl font-bold text-[var(--color-text)] mb-10">关于</h1>

    <dl class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:gap-8">
        <dt class="text-sm font-medium text-[var(--color-text-muted)] sm:w-36 shrink-0 mb-1 sm:mb-0">姓名</dt>
        <dd class="text-[var(--color-text)]">Zhuoyang Li</dd>
      </div>

      <div class="flex flex-col sm:flex-row sm:gap-8">
        <dt class="text-sm font-medium text-[var(--color-text-muted)] sm:w-36 shrink-0 mb-1 sm:mb-0">教育经历</dt>
        <dd class="text-[var(--color-text)]">HIT 大四</dd>
      </div>

      <div class="flex flex-col sm:flex-row sm:gap-8">
        <dt class="text-sm font-medium text-[var(--color-text-muted)] sm:w-36 shrink-0 mb-1 sm:mb-0">研究方向</dt>
        <dd class="text-[var(--color-text)]">
          机器人 · 具身智能 · 计算机视觉 
        </dd>
      </div>

      <div class="flex flex-col sm:flex-row sm:gap-8">
        <dt class="text-sm font-medium text-[var(--color-text-muted)] sm:w-36 shrink-0 mb-1 sm:mb-0">GitHub</dt>
        <dd>
          <a
            href="https://github.com/Sakura-beautiful"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent hover:underline"
          >
            github.com/Sakura-beautiful
          </a>
        </dd>
      </div>

      <div class="flex flex-col sm:flex-row sm:gap-8">
        <dt class="text-sm font-medium text-[var(--color-text-muted)] sm:w-36 shrink-0 mb-1 sm:mb-0">邮箱</dt>
        <dd class="text-[var(--color-text)]">2023112666@hit.edu.cn</dd>
      </div>

      <div class="flex flex-col sm:flex-row sm:gap-8">
        <dt class="text-sm font-medium text-[var(--color-text-muted)] sm:w-36 shrink-0 mb-1 sm:mb-0">简历</dt>
        <dd>
          <a href="#" class="text-accent hover:underline">[简历 PDF 链接]</a>
        </dd>
      </div>
    </dl>

    <div class="mt-16 pt-8 border-t border-[var(--color-border)]">
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
        This site is a personal research wiki — a living record of what I learn, build, and understand 
        in the fields of robotics, AI, and embodied intelligence.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .text-accent { color: #4f6ef7; }
</style>
