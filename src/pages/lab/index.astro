---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const entries = (await getCollection('lab', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Lab" description="Experiment logs, debug sessions, and exploration records.">
  <div class="container-wiki py-12">
    <div class="mb-10">
      <h1 class="text-2xl font-bold text-[var(--color-text)] mb-2">Lab</h1>
      <p class="text-[var(--color-text-muted)]">
        Raw experiment logs, debug records, and technical explorations.
      </p>
    </div>

    {entries.length === 0 ? (
      <p class="text-[var(--color-text-muted)] text-sm py-12 text-center">No lab records yet.</p>
    ) : (
      <div class="flex flex-col gap-3">
        {entries.map(entry => (
          <Card
            href={`${base}lab/${entry.slug}/`}
            title={entry.data.title}
            description={entry.data.description}
            date={entry.data.date}
            tags={entry.data.tags}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
