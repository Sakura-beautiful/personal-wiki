---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const papers   = await getCollection('papers',   ({ data }) => !data.draft);
const projects = await getCollection('projects', ({ data }) => !data.draft);
const lab      = await getCollection('lab',      ({ data }) => !data.draft);
const blog     = await getCollection('blog',     ({ data }) => !data.draft);

const sortByDate = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();

const latest = [...papers, ...blog, ...lab]
  .sort(sortByDate)
  .slice(0, 6);

const featuredProjects = projects.filter(p => p.data.featured).slice(0, 3);
const recentLab = [...lab].sort(sortByDate).slice(0, 3);

const sections = [
  { label: 'Docs',     href: `${base}docs/`,     desc: 'System-level technical knowledge across robotics, AI, and engineering.',    icon: '📚' },
  { label: 'Papers',   href: `${base}papers/`,   desc: 'Reading notes and personal understanding of research papers.',               icon: '📄' },
  { label: 'Projects', href: `${base}projects/`, desc: 'Open source projects with full documentation and experiments.',              icon: '🔧' },
  { label: 'Lab',      href: `${base}lab/`,      desc: 'Raw experiment logs, debug sessions, and exploration records.',              icon: '🧪' },
];
---

<BaseLayout title="Home" description="Notes on building machines that understand the world.">

  <!-- Hero -->
  <section class="pt-20 pb-16 md:pt-28 md:pb-20">
    <div class="container-wiki max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-muted)] mb-6">
        Personal Research Wiki
      </p>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--color-text)] leading-[1.15] mb-5">
        Notes on building machines<br class="hidden sm:block" />
        that understand the world.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] mb-8">
        Robotics · AI · Embodied Intelligence
      </p>
      <a
        href={`${base}docs/`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
               bg-accent text-white font-medium text-sm
               hover:bg-[#3d5ce0] transition-colors"
      >
        Browse Docs
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Explore -->
  <section class="py-12 border-t border-[var(--color-border)]">
    <div class="container-wiki">
      <p class="section-heading">Explore</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {sections.map(s => (
          <a href={s.href} class="card-base group flex flex-col gap-3">
            <span class="text-2xl">{s.icon}</span>
            <div>
              <h2 class="font-semibold text-[var(--color-text)] group-hover:text-accent transition-colors mb-1">
                {s.label}
              </h2>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{s.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest -->
  {latest.length > 0 && (
    <section class="py-12 border-t border-[var(--color-border)]">
      <div class="container-wiki">
        <p class="section-heading">Latest</p>
        <div class="flex flex-col gap-3">
          {latest.map(entry => {
            const collection = entry.collection as string;
            const href = `${base}${collection}/${entry.slug}/`;
            return (
              <Card
                href={href}
                title={entry.data.title}
                description={entry.data.description}
                date={entry.data.date}
                tags={entry.data.tags}
                meta={collection.charAt(0).toUpperCase() + collection.slice(1)}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Featured Projects -->
  {featuredProjects.length > 0 && (
    <section class="py-12 border-t border-[var(--color-border)]">
      <div class="container-wiki">
        <div class="flex items-center justify-between mb-4">
          <p class="section-heading mb-0">Featured Projects</p>
          <a href={`${base}projects/`} class="text-xs text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">
            All projects →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {featuredProjects.map(p => (
            <Card
              href={`${base}projects/${p.slug}/`}
              title={p.data.title}
              description={p.data.description}
              tags={p.data.tags}
              status={p.data.status}
              github={p.data.github}
              variant="project"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Recent Lab Notes -->
  {recentLab.length > 0 && (
    <section class="py-12 border-t border-[var(--color-border)]">
      <div class="container-wiki">
        <div class="flex items-center justify-between mb-4">
          <p class="section-heading mb-0">Recent Lab Notes</p>
          <a href={`${base}lab/`} class="text-xs text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">
            All records →
          </a>
        </div>
        <div class="flex flex-col gap-3">
          {recentLab.map(entry => (
            <Card
              href={`${base}lab/${entry.slug}/`}
              title={entry.data.title}
              description={entry.data.description}
              date={entry.data.date}
              tags={entry.data.tags}
            />
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .bg-accent { background-color: #4f6ef7; }
  .bg-accent:hover { background-color: #3d5ce0; }
</style>
