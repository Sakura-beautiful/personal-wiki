---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects" description="Open source projects with full documentation and experiments.">
  <div class="container-wiki py-12">
    <div class="mb-10">
      <h1 class="text-2xl font-bold text-[var(--color-text)] mb-2">Projects</h1>
      <p class="text-[var(--color-text-muted)]">
        Open source projects — architecture, demos, and implementation details.
      </p>
    </div>

    {projects.length === 0 ? (
      <p class="text-[var(--color-text-muted)] text-sm py-12 text-center">No projects yet.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {projects.map(entry => (
          <Card
            href={`${base}projects/${entry.slug}/`}
            title={entry.data.title}
            description={entry.data.description}
            tags={entry.data.tags}
            status={entry.data.status}
            github={entry.data.github}
            variant="project"
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
